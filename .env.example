# ============================================================================
# MTA University Library Collector — environment template
# Copy to .env and adjust. Never commit real secrets.
# ============================================================================

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Data locations (defaults are relative to the project root)
MTA_DATA_DIR=./data
MTA_DB_PATH=./data/mta_academic.db
MTA_UPLOADS_DIR=./data/uploads

# Sessions and request limits
SESSION_DAYS=7
MAX_UPLOAD_MB=25
JSON_BODY_LIMIT=2mb
UPLOAD_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_15_MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=5
REPORT_RATE_LIMIT_PER_HOUR=10

# CORS: comma-separated exact origins. Leave empty for localhost defaults.
# Include the production web origin and, if used, the Capacitor origin.
CORS_ORIGINS=
TRUST_PROXY=false

# Database bootstrap
# The first super administrator is created only when no administrator exists.
# If MTA_INITIAL_ADMIN_PASSWORD is empty, a random one-time password is
# generated and written (mode 0600) to data/initial-admin-credentials.txt.
# Delete that file after storing the password securely.
MTA_ADMIN_EMAIL=admin@mta-tech.ye
MTA_INITIAL_ADMIN_PASSWORD=
MTA_SKIP_SEED=false

# Optional integrations — all disabled by default.
# Advertising must remain disabled unless the owner explicitly enables it and
# supplies real production IDs. No analytics are sent without consent.
MTA_ADS_ENABLED=false
MTA_ANALYTICS_ENABLED=false
MTA_FIREBASE_ENABLED=false
# GEMINI_API_KEY=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_GA_MEASUREMENT_ID=
# VITE_ADMOB_APP_ID=

# Frontend
# Leave empty when the API is served by the same origin (default).
VITE_API_BASE_URL=

# Capacitor Android
# Optional absolute backend URL for live-server mode, e.g. https://api.example.org
# Leave empty to load the bundled web build from the APK. HTTPS is required
# unless you deliberately test against a local HTTP origin.
CAPACITOR_SERVER_URL=

# PostgreSQL (production schema is included but not enabled in this runtime)
# DATABASE_URL=postgresql://user:password@host:5432/mta_library
